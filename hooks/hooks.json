{
  "description": "Send Stop and permission notifications to the local TaskHub hub (http://127.0.0.1:47800)",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:47800/api/hooks/claude", "headers": { "X-TaskHub": "1" }, "timeout": 5 }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:47800/api/hooks/claude", "headers": { "X-TaskHub": "1" }, "timeout": 5 }
        ]
      }
    ]
  }
}
